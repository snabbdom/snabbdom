    "removeComments": false,
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "strictFunctionTypes": false,
    "moduleResolution": "node",
    "target": "es6",
    "isolatedModules": true,
    "outDir": "build",
    "skipLibCheck": true
  },
  "include": ["./src/index.ts"]
}
